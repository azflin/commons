{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "cream": "#F5F1E9",
    "creamDim": "#B8B3A6",
    "gray": "#6E7180",
    "blue": "#061BFF",
    "blueBright": "#5B6BFF",
    "yellow": "#DBFD00",
    "yellowDim": "#9FB800",
    "navyBg": "#0B1340",
    "panel": "#141D5C",
    "element": "#1E2A78",
    "borderClr": "#33449E",
    "borderDim": "#1B2766",
    "red": "#FF5C5C",
    "redBright": "#FF8E8E",
    "green": "#3FE0A0",
    "greenBright": "#74EFC2",
    "magenta": "#D26AC2",
    "lightBg": "#F5F1E9",
    "lightPanel": "#EAE5D9",
    "lightElement": "#DCD6C8",
    "lightBorder": "#C4BDA9",
    "lightText": "#0B0E1A",
    "lightMuted": "#5F5E4F",
    "lightBlue": "#061BFF",
    "lightYellowDim": "#8A9E00",
    "lightRed": "#C7392D",
    "lightGreen": "#2E8F5F",
    "lightMagenta": "#A8527A"
  },
  "theme": {
    "primary": { "dark": "yellow", "light": "lightBlue" },
    "secondary": { "dark": "blueBright", "light": "lightBlue" },
    "accent": { "dark": "yellow", "light": "lightBlue" },
    "error": { "dark": "red", "light": "lightRed" },
    "warning": { "dark": "yellow", "light": "lightYellowDim" },
    "success": { "dark": "green", "light": "lightGreen" },
    "info": { "dark": "blueBright", "light": "lightBlue" },
    "text": { "dark": "cream", "light": "lightText" },
    "textMuted": { "dark": "creamDim", "light": "lightMuted" },
    "background": { "dark": "navyBg", "light": "lightBg" },
    "backgroundPanel": { "dark": "panel", "light": "lightPanel" },
    "backgroundElement": { "dark": "element", "light": "lightElement" },
    "border": { "dark": "borderClr", "light": "lightBorder" },
    "borderActive": { "dark": "yellow", "light": "lightBlue" },
    "borderSubtle": { "dark": "borderDim", "light": "lightElement" },
    "diffAdded": { "dark": "green", "light": "lightGreen" },
    "diffRemoved": { "dark": "red", "light": "lightRed" },
    "diffContext": { "dark": "gray", "light": "lightMuted" },
    "diffHunkHeader": { "dark": "blueBright", "light": "lightBlue" },
    "diffHighlightAdded": { "dark": "greenBright", "light": "lightGreen" },
    "diffHighlightRemoved": { "dark": "redBright", "light": "lightRed" },
    "diffAddedBg": { "dark": "#0E2A1E", "light": "#E0EEE5" },
    "diffRemovedBg": { "dark": "#2A1414", "light": "#EEE0E0" },
    "diffContextBg": { "dark": "panel", "light": "lightPanel" },
    "diffLineNumber": { "dark": "gray", "light": "lightMuted" },
    "diffAddedLineNumberBg": { "dark": "#0C1F16", "light": "#D5E5DA" },
    "diffRemovedLineNumberBg": { "dark": "#1F0C0C", "light": "#E5D5D5" },
    "markdownText": { "dark": "cream", "light": "lightText" },
    "markdownHeading": { "dark": "yellow", "light": "lightBlue" },
    "markdownLink": { "dark": "blueBright", "light": "lightBlue" },
    "markdownLinkText": { "dark": "greenBright", "light": "lightGreen" },
    "markdownCode": { "dark": "greenBright", "light": "lightGreen" },
    "markdownBlockQuote": { "dark": "gray", "light": "lightMuted" },
    "markdownEmph": { "dark": "yellow", "light": "lightBlue" },
    "markdownStrong": { "dark": "cream", "light": "lightText" },
    "markdownHorizontalRule": { "dark": "gray", "light": "lightMuted" },
    "markdownListItem": { "dark": "yellow", "light": "lightBlue" },
    "markdownListEnumeration": { "dark": "blueBright", "light": "lightBlue" },
    "markdownImage": { "dark": "blueBright", "light": "lightBlue" },
    "markdownImageText": { "dark": "greenBright", "light": "lightGreen" },
    "markdownCodeBlock": { "dark": "cream", "light": "lightText" },
    "syntaxComment": { "dark": "gray", "light": "lightMuted" },
    "syntaxKeyword": { "dark": "yellow", "light": "lightBlue" },
    "syntaxFunction": { "dark": "blueBright", "light": "lightBlue" },
    "syntaxVariable": { "dark": "cream", "light": "lightText" },
    "syntaxString": { "dark": "green", "light": "lightGreen" },
    "syntaxNumber": { "dark": "magenta", "light": "lightMagenta" },
    "syntaxType": { "dark": "greenBright", "light": "lightGreen" },
    "syntaxOperator": { "dark": "yellowDim", "light": "lightYellowDim" },
    "syntaxPunctuation": { "dark": "cream", "light": "lightText" }
  }
}
